{
  "name": "handykit-desktop",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:online": "tauri build --config src-tauri/tauri.online.conf.json",
    "build:offline": "tauri build --config src-tauri/tauri.offline.conf.json",
    "build:dev": "tauri build --debug --no-bundle",
    "package:dev": "tauri build --debug",
    "test": "node --experimental-strip-types --test src/app/workspace.test.ts src/app/lifecycle.test.ts src/views/home.test.ts src/tasks/model.test.ts src/tasks/view.test.cjs src/plugins/view.test.cjs src/plugins/sync-view.test.cjs",
    "package:local": "node ../../../scripts/package_local.mjs",
    "format": "prettier --write \"src/**/*.{ts,cjs,css}\" vite.config.ts index.html",
    "format:check": "prettier --check \"src/**/*.{ts,cjs,css}\" vite.config.ts index.html"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "linkedom": "0.18.12",
    "prettier": "3.6.2",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  }
}
